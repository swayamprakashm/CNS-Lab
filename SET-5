7. Write the RC4 logic in Java Using Java cryptography; encrypt the text “Hello world” using Blowfish. Create your own key using Java key tool.

import javax.crypto.Cipher;
import javax.crypto.KeyGenerator;
import javax.crypto.SecretKey;
import java.util.Scanner;
public class BlowFishCipher {
    public static void main(String[] args) throws Exception {
        Scanner sc = new Scanner(System.in);
        KeyGenerator keygenerator = KeyGenerator.getInstance("Blowfish");
        SecretKey secretkey = keygenerator.generateKey();
        Cipher cipher = Cipher.getInstance("Blowfish");
        System.out.print("Input your message: ");
        String inputText = sc.nextLine();
        cipher.init(Cipher.ENCRYPT_MODE, secretkey);
        byte[] encrypted = cipher.doFinal(inputText.getBytes("UTF-8"));
        StringBuilder encryptedHex = new StringBuilder();
        for (byte b : encrypted) {
            encryptedHex.append(String.format("%02X", b & 0xFF));
        }
        cipher.init(Cipher.DECRYPT_MODE, secretkey);
        byte[] decrypted = cipher.doFinal(encrypted);
        System.out.println("Encrypted text: " + encryptedHex);
        System.out.println("Decrypted text: " + new String(decrypted, "UTF-8"));

        sc.close();
    }
}
